# ==============================================================================
# NOVA AI v2 — Configuración de Entorno
# ==============================================================================

# 1. CANAL PRINCIPAL: Google AI Studio (Razonamiento Complejo, Documentos)
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# 2. CANAL AUXILIAR: Groq (Baja Latencia, Diálogo Rápido, Visión)
# Obtén tu clave en: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=2000

# 3. LÍNEA DE DEFENSA & CÓDIGO: OpenRouter (Modelos Gratuitos / Code)
# Obtén tu clave en: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_FREE_MODEL=openrouter/free
OPENROUTER_CODE_MODEL=qwen/qwen-2.5-coder-32b-instruct:free

# 4. PERSISTENCIA: Supabase (PostgreSQL 15)
# Proyecto en: https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# 5. SEGURIDAD Y ENTORNO
ADMIN_KEY=your_admin_secret_token_here
ALLOWED_ORIGINS=https://nova-ai.vercel.app,http://localhost:3000,http://localhost:8000
DEBUG=false
